from PIL import Image
import os
import mmap

FB = "/dev/fb1"
WIDTH = 480
HEIGHT = 320
IMAGE = "/home/raspdixit/map.jpg"

# Open framebuffer
fb = os.open(FB, os.O_RDWR)

# For 480x320 RGB565:
# 2 bytes per pixel
LINE_LENGTH = WIDTH * 2
FB_SIZE = LINE_LENGTH * HEIGHT

print("Framebuffer:", FB)
print("Resolution:", WIDTH, "x", HEIGHT)
print("Bits per pixel: 16")
print("Line length:", LINE_LENGTH)

# Load image
img = Image.open(IMAGE).convert("RGB")
img = img.resize((WIDTH, HEIGHT), Image.Resampling.LANCZOS)

# Create RGB565 framebuffer data
buffer = bytearray(FB_SIZE)

for y in range(HEIGHT):
    for x in range(WIDTH):

        r, g, b = img.getpixel((x, y))

        # RGB888 -> RGB565
        rgb565 = (
            ((r >> 3) << 11) |
            ((g >> 2) << 5) |
            (b >> 3)
        )

        offset = y * LINE_LENGTH + x * 2

        buffer[offset] = rgb565 & 0xFF
        buffer[offset + 1] = (rgb565 >> 8) & 0xFF

# Map framebuffer into memory
mm = mmap.mmap(
    fb,
    FB_SIZE,
    mmap.MAP_SHARED,
    mmap.PROT_READ | mmap.PROT_WRITE
)

# Write image
mm.seek(0)
mm.write(buffer)
mm.flush()

mm.close()
os.close(fb)

print("MAP DISPLAYED ON TFT")
