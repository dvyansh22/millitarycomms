CITADEL_MASTER_KEY=replace-with-a-long-random-master-key
CITADEL_SESSION_SECRET=replace-with-a-different-long-random-session-secret
CITADEL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
CITADEL_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
CITADEL_CLOCK_SKEW=120
ENABLE_SERIAL_INGEST=false
SERIAL_PORT=auto
SERIAL_BAUD_RATE=115200
ENABLE_HEART_RATE_POLLING=false
